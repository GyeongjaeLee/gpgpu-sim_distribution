// Arch	  SM	TPC	GPC	Part.	L2slices  L2size  MemCtrl
// GP100	60	30	6	  1	    8(512KB?) 4MB     8(512bit)
// GV100	84	42	6	  1	    32(96KB)  6MB     8(512bit)
// GA100	128	64	8	  2	    96(512KB) 48MB    12(512bit)
// GH100	144	72	8	  2	           60MB    12(512bit)

// GV100
// Topology
topology = gpunet;
l = 3;
// this must match the sum of n_shader and n_mem in gpgpu_sim.config
shader = 84;
l2slice = 32;
// Assume partitions are uniformly sized
use_partition = 0;
units = {2,7,6};
speedups = {1,2,14,1};
interpartition_speedup = 28;

// Routing
routing_function = hierarchical;

router = iq;
vc_allocator = islip;
sw_allocator = islip;
alloc_iters = 1;

input_speedup = 1;
output_speedup = 1;
internal_speedup = 1.0;


vc_alloc_delay = 1;
sw_alloc_delay = 1;
routing_delay = 0;
credit_delay = 0;

// Flow control
// GPGPU-Sim uses 1 VC by default
num_vcs = 1;
vc_buf_size = 256;

// Note that setting this to 0 allows channels with enough bandwidth
// to transfer more flits than packet_length
// which means more than 1 packets in a single vc can exist
wait_for_tail_credit = 0;

// Traffic
traffic = gpu;

subnets = 2;

use_read_write = 1;

write_fraction = 0.5;

read_request_subnet = 0;
read_reply_subnet = 1;
write_request_subnet = 0;
write_reply_subnet = 1;

read_request_begin_vc = 0;
read_request_end_vc = 0;
write_request_begin_vc = 0;
write_request_end_vc = 0;
read_reply_begin_vc = 0;
read_reply_end_vc = 0;
write_reply_begin_vc = 0;
write_reply_end_vc = 0;

read_request_size = 1;
read_reply_size = 9;
write_request_size = 9;
write_reply_size = 1;

// Simulation
injection_process = gpu_bernoulli;
injection_rate = 0.001;
latency_thres = 50000.0;

sim_type = throughput;
sim_count = 1;
sample_period = 10000;
max_samples = 10;
warmup_periods = 3;
