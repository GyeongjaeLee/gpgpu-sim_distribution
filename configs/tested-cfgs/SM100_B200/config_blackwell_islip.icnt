// GPUNet Multiport Configuration for A100
use_map = 0;
flit_size = 40;

network_count = 2;

// Topology
topology = gpunet_multiport;

// Number of shader cores and L2 slices
shader = 148;
l2slice = 128;

// Partition configuration
use_partition = 1;
n_partition = 2;

// Number of parallel interpartition ports (instead of bandwidth increase)
// This replaces interpartition_speedup from original GPUNet
interpartition_ports = 143;

// Latencies (cycles)
inject_eject_latency = 40;
interpartition_latency = 50;

// Routing
routing_function = hierarchical;

// Flow control
num_vcs = 1;
vc_buf_size = 256;
input_buffer_size = 256;
ejection_buffer_size = 512;
boundary_buffer_size = 512;

wait_for_tail_credit = 0;

// Router architecture
router = iq;
vc_allocator = islip;
sw_allocator = islip;
alloc_iters = 1;

credit_delay = 0;
routing_delay = 0;
vc_alloc_delay = 1;
sw_alloc_delay = 1;

input_speedup = 1;
output_speedup = 1;
internal_speedup = 2.0;

// Traffic (not used by GPGPU-Sim)
traffic = uniform;
packet_size = {{1,2,3,4},{10,20}};
packet_size_rate = {{1,1,1,1},{2,1}};

// Simulation
sim_type = gpgpusim;
injection_rate = 0.1;

subnets = 2;

read_request_subnet = 0;
read_reply_subnet = 1;
write_request_subnet = 0;
write_reply_subnet = 1;

read_request_begin_vc = 0;
read_request_end_vc = 0;
write_request_begin_vc = 0;
write_request_end_vc = 0;
read_reply_begin_vc = 0;
read_reply_end_vc = 0;
write_reply_begin_vc = 0;
write_reply_end_vc = 0;
